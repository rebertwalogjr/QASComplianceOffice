generator client {
  provider               = "prisma-client"
  output                 = "../generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "sqlserver"
  // url      = env("DATABASE_URL")
}

model AppSuiteEmployeeMaster {
  employeeNumber String    @id @db.NVarChar(10)
  lastName       String    @db.NVarChar(255)
  firstName      String    @db.NVarChar(255)
  middleName     String?   @db.NVarChar(255)
  fullName       String    @db.NVarChar(255)
  emailAddress   String?   @db.NVarChar(255)
  department     String?   @db.NVarChar(255)
  position       String?   @db.NVarChar(255)
  isActive       Boolean   @default(true) @db.Bit
  addedOn        DateTime  @default(now()) @db.DateTime
  inactiveOn     DateTime? @db.DateTime
  users          User[]
}

model AuditEngagement {
  id             Int              @id @default(autoincrement())
  name           String           @unique @db.NVarChar(50)
  companyId      Int
  isActive       Boolean          @default(true) @db.Bit
  createdBy      Int
  createdOn      DateTime         @default(now()) @db.DateTime
  modifiedBy     Int?
  modifiedOn     DateTime         @updatedAt @db.DateTime
  company        Company          @relation(fields: [companyId], references: [id], onUpdate: NoAction)
  creator        User             @relation("EngagementCreator", fields: [createdBy], references: [id], onUpdate: NoAction, onDelete: NoAction)
  modifier       User?            @relation("EngagementModifier", fields: [modifiedBy], references: [id], onUpdate: NoAction, onDelete: NoAction)
  jobTransaction JobTransaction[]
  auditReport    AuditReport[]
}

model Company {
  id              Int               @id @default(autoincrement())
  name            String            @unique @db.NVarChar(255)
  code            String            @unique @db.NVarChar(15)
  isActive        Boolean           @default(true) @db.Bit
  createdBy       Int
  createdOn       DateTime          @default(now()) @db.DateTime
  modifiedBy      Int?
  modifiedOn      DateTime          @updatedAt @db.DateTime
  creator         User              @relation("CompanyCreator", fields: [createdBy], references: [id], onUpdate: NoAction, onDelete: NoAction)
  modifier        User?             @relation("CompanyModifier", fields: [modifiedBy], references: [id], onUpdate: NoAction, onDelete: NoAction)
  auditEngagement AuditEngagement[]
  project         Project[]
  users           User[]
  jobTransaction  JobTransaction[]
  auditReport     AuditReport[]
  auditRating     AuditRating[]
}

model FindingCategory {
  id             Int              @id @default(autoincrement())
  name           String           @unique @db.NVarChar(50)
  isActive       Boolean          @default(true) @db.Bit
  createdBy      Int
  createdOn      DateTime         @default(now()) @db.DateTime
  modifiedBy     Int?
  modifiedOn     DateTime         @updatedAt @db.DateTime
  creator        User             @relation("CategoryCreator", fields: [createdBy], references: [id], onUpdate: NoAction, onDelete: NoAction)
  modifier       User?            @relation("CategoryModifier", fields: [modifiedBy], references: [id], onUpdate: NoAction, onDelete: NoAction)
  jobTransaction JobTransaction[]
}

model JobTransaction {
  id                           Int              @id @default(autoincrement())
  jobStatus                    String           @db.NVarChar(50)
  companyId                    Int
  projectId                    Int
  auditEngagementId            Int
  typeOfFindingId              Int
  findingCategoryId            Int
  complianceSecretariatId      Int
  complianceOfficerId          Int
  supervisorId                 Int
  auditReportId                Int
  auditFindingNumber           String           @db.NVarChar(100)
  issuedOn                     DateTime?        @db.DateTime
  targetDate                   DateTime?        @db.DateTime
  auditRatingId                Int
  projectManagerDepartmentHead String?          @db.NVarChar(100)
  responsibleDepartment        String?          @db.NVarChar(255)
  responsiblePerson            String?          @db.NVarChar(255)
  recurringPerProcess          Boolean          @default(false) @db.Bit
  recurringPerPerson           Boolean          @default(false) @db.Bit
  recipientGroupId             Int?
  recipientId                  Int?
  problemCriteria              String?          @db.NVarChar(Max)
  problemFindings              String?          @db.NVarChar(Max)
  recommendations              String?          @db.NVarChar(Max)
  verifiedBy                   Int?
  verifiedOn                   DateTime?        @db.DateTime
  approvedBy                   Int?
  approvedOn                   DateTime?        @db.DateTime
  correctiveAction             String?          @db.NVarChar(Max)
  correctiveCommitmentDate     DateTime?        @db.DateTime
  preventiveAction             String?          @db.NVarChar(Max)
  preventiveCommitmentDate     DateTime?        @db.DateTime
  deemedAccepted               Boolean          @default(false) @db.Bit
  approvedForClosing           Boolean          @default(false) @db.Bit
  endorsedForApproval          Boolean          @default(false) @db.Bit
  onHold                       Boolean          @default(false) @db.Bit
  isActive                     Boolean          @default(true) @db.Bit
  cancelledOn                  DateTime?        @db.DateTime
  closedOn                     DateTime?        @db.DateTime
  hasBeenReadByAssignee        Boolean          @default(false) @db.Bit
  readByAssigneeOn             DateTime?        @db.DateTime
  jobEscalation1               Int?
  jobEscalation2               Int?
  jobEscalation3               Int?
  jobEscalation4               Int?
  createdBy                    Int
  createdOn                    DateTime         @default(now()) @db.DateTime
  modifiedBy                   Int?
  modifiedOn                   DateTime         @updatedAt @db.DateTime
  company                      Company          @relation(fields: [companyId], references: [id], onUpdate: NoAction)
  project                      Project          @relation(fields: [projectId], references: [id], onUpdate: NoAction)
  auditEngagement              AuditEngagement  @relation(fields: [auditEngagementId], references: [id], onUpdate: NoAction)
  typeOfFinding                TypeOfFinding    @relation(fields: [typeOfFindingId], references: [id], onUpdate: NoAction)
  findingCategory              FindingCategory  @relation(fields: [findingCategoryId], references: [id], onUpdate: NoAction)
  group                        Group?           @relation(fields: [recipientGroupId], references: [id], onUpdate: NoAction)
  auditReport                  AuditReport      @relation(fields: [auditReportId], references: [id], onUpdate: NoAction)
  auditRating                  AuditRating      @relation(fields: [auditRatingId], references: [id], onUpdate: NoAction)
  recipient                    User?            @relation("JobTransactionRecipient", fields: [recipientId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  complianceSecretariat        User             @relation("ComplianceSecretariat", fields: [complianceSecretariatId], references: [id], onUpdate: NoAction)
  complianceOfficer            User             @relation("ComplianceOfficer", fields: [complianceOfficerId], references: [id], onUpdate: NoAction)
  supervisor                   User             @relation("Supervisor", fields: [supervisorId], references: [id], onUpdate: NoAction)
  verifier                     User?            @relation("JobTransactionVerifier", fields: [verifiedBy], references: [id], onUpdate: NoAction, onDelete: NoAction)
  approver                     User?            @relation("JobTransactionApprover", fields: [approvedBy], references: [id], onUpdate: NoAction, onDelete: NoAction)
  creator                      User             @relation("JobTransactionCreator", fields: [createdBy], references: [id], onUpdate: NoAction, onDelete: NoAction)
  modifier                     User?            @relation("JobTransactionModifier", fields: [modifiedBy], references: [id], onUpdate: NoAction, onDelete: NoAction)
  auditTrails                  AuditTrail[]
  attachments                  Attachment[]
  jobEscalation1User           User?            @relation("jobEscalation1User", fields: [jobEscalation1], references: [id], onUpdate: NoAction, onDelete: NoAction)
  jobEscalation2User           User?            @relation("jobEscalation2User", fields: [jobEscalation2], references: [id], onUpdate: NoAction, onDelete: NoAction)
  jobEscalation3User           User?            @relation("jobEscalation3User", fields: [jobEscalation3], references: [id], onUpdate: NoAction, onDelete: NoAction)
  jobEscalation4User           User?            @relation("jobEscalation4User", fields: [jobEscalation4], references: [id], onUpdate: NoAction, onDelete: NoAction)
  holdingHistories             HoldingHistory[]
  updateTrails                 UpdateTrail[]
  reviewTrails                 ReviewTrail[]
}

model Project {
  id             Int              @id @default(autoincrement())
  name           String           @unique @db.NVarChar(100)
  code           String           @unique @db.NVarChar(10)
  companyId      Int
  remarks        String?          @db.NVarChar(255)
  isActive       Boolean          @default(true) @db.Bit
  createdBy      Int
  createdOn      DateTime         @default(now()) @db.DateTime
  modifiedBy     Int?
  modifiedOn     DateTime         @updatedAt @db.DateTime
  company        Company          @relation(fields: [companyId], references: [id], onUpdate: NoAction)
  creator        User             @relation("ProjectCreator", fields: [createdBy], references: [id], onUpdate: NoAction, onDelete: NoAction)
  modifier       User?            @relation("ProjectModifier", fields: [modifiedBy], references: [id], onUpdate: NoAction, onDelete: NoAction)
  groupList      Group[]
  jobTransaction JobTransaction[]
  auditReport    AuditReport[]
  userProjects   UserProject[]
}

model TypeOfFinding {
  id             Int              @id @default(autoincrement())
  name           String           @unique @db.NVarChar(50)
  isActive       Boolean          @default(true) @db.Bit
  createdBy      Int
  createdOn      DateTime         @default(now()) @db.DateTime
  modifiedBy     Int?
  modifiedOn     DateTime         @updatedAt @db.DateTime
  creator        User             @relation("TypeOfFindingCreator", fields: [createdBy], references: [id], onUpdate: NoAction, onDelete: NoAction)
  modifier       User?            @relation("TypeOfFindingModifier", fields: [modifiedBy], references: [id], onUpdate: NoAction, onDelete: NoAction)
  jobTransaction JobTransaction[]
}

model Attachment {
  id               Int            @id @default(autoincrement())
  jobTransactionId Int
  fileName         String         @db.NVarChar(255)
  fileType         String         @db.NVarChar(255)
  fileSize         Int
  fromRecipient    Boolean
  isActive         Boolean        @default(true) @db.Bit
  createdBy        Int
  createdOn        DateTime       @default(now()) @db.DateTime
  modifiedBy       Int?
  modifiedOn       DateTime       @updatedAt @db.DateTime
  creator          User           @relation("AttachmentCreator", fields: [createdBy], references: [id], onUpdate: NoAction, onDelete: NoAction)
  modifier         User?          @relation("AttachmentModifier", fields: [modifiedBy], references: [id], onUpdate: NoAction, onDelete: NoAction)
  jobTransaction   JobTransaction @relation(fields: [jobTransactionId], references: [id])
}

model Group {
  id              Int              @id @default(autoincrement())
  name            String           @unique @db.NVarChar(100)
  code            String           @unique @db.NVarChar(10)
  projectId       Int
  inCharge        String           @db.NVarChar(100)
  emailAddress    String           @db.NVarChar(255)
  remarks         String?          @db.NVarChar(255)
  isActive        Boolean          @default(true) @db.Bit
  createdBy       Int
  createdOn       DateTime         @default(now()) @db.DateTime
  modifiedBy      Int?
  modifiedOn      DateTime         @updatedAt @db.DateTime
  project         Project          @relation(fields: [projectId], references: [id], onUpdate: NoAction)
  creator         User             @relation("GroupCreator", fields: [createdBy], references: [id], onUpdate: NoAction, onDelete: NoAction)
  modifier        User?            @relation("GroupModifier", fields: [modifiedBy], references: [id], onUpdate: NoAction, onDelete: NoAction)
  jobTransactions JobTransaction[]
  userGroups      UserGroup[]
}

model User {
  id                        Int                    @id @default(autoincrement())
  employeeNumber            String                 @unique @db.NVarChar(10)
  username                  String                 @unique @db.NVarChar(100)
  password                  String                 @db.NVarChar(100)
  emailAddress              String?                @db.NVarChar(255)
  companyId                 Int?
  position                  String?                @db.NVarChar(100)
  escalation1               Int?
  escalation2               Int?
  escalation3               Int?
  escalation4               Int?
  receiveNotifications      Boolean                @default(false) @db.Bit
  isEscalation              Boolean                @default(false) @db.Bit
  isActive                  Boolean                @default(true) @db.Bit
  isActivated               Boolean                @default(false) @db.Bit
  createdBy                 Int?
  createdOn                 DateTime               @default(now()) @db.DateTime
  modifiedBy                Int?
  modifiedOn                DateTime               @updatedAt @db.DateTime
  escalation1User           User?                  @relation("escalation1User", fields: [escalation1], references: [id], onUpdate: NoAction, onDelete: NoAction)
  escalation2User           User?                  @relation("escalation2User", fields: [escalation2], references: [id], onUpdate: NoAction, onDelete: NoAction)
  escalation3User           User?                  @relation("escalation3User", fields: [escalation3], references: [id], onUpdate: NoAction, onDelete: NoAction)
  escalation4User           User?                  @relation("escalation4User", fields: [escalation4], references: [id], onUpdate: NoAction, onDelete: NoAction)
  creator                   User?                  @relation("UserCreator", fields: [createdBy], references: [id], onUpdate: NoAction, onDelete: NoAction)
  modifier                  User?                  @relation("UserModifier", fields: [modifiedBy], references: [id], onUpdate: NoAction, onDelete: NoAction)
  appSuiteEmployeeMaster    AppSuiteEmployeeMaster @relation(fields: [employeeNumber], references: [employeeNumber])
  company                   Company?               @relation(fields: [companyId], references: [id], onUpdate: NoAction)
  auditEngagementCreator    AuditEngagement[]      @relation("EngagementCreator")
  auditEngagementModifier   AuditEngagement[]      @relation("EngagementModifier")
  companyCreator            Company[]              @relation("CompanyCreator")
  companyModifier           Company[]              @relation("CompanyModifier")
  findingCategoriesCreator  FindingCategory[]      @relation("CategoryCreator")
  findingCategoriesModifier FindingCategory[]      @relation("CategoryModifier")
  jobTransactionsCreator    JobTransaction[]       @relation("JobTransactionCreator")
  jobTransactionsModifier   JobTransaction[]       @relation("JobTransactionModifier")
  projectCreator            Project[]              @relation("ProjectCreator")
  projectModifier           Project[]              @relation("ProjectModifier")
  typeOfFindingsCreator     TypeOfFinding[]        @relation("TypeOfFindingCreator")
  typeOfFindingsModifier    TypeOfFinding[]        @relation("TypeOfFindingModifier")
  attachmentsCreator        Attachment[]           @relation("AttachmentCreator")
  attachmentsModifier       Attachment[]           @relation("AttachmentModifier")
  groupCreator              Group[]                @relation("GroupCreator")
  groupModifier             Group[]                @relation("GroupModifier")
  userCreator               User[]                 @relation("UserCreator")
  userModifier              User[]                 @relation("UserModifier")
  auditReportCreator        AuditReport[]          @relation("AuditReportCreator")
  auditReportModifier       AuditReport[]          @relation("AuditReportModifier")
  auditRatingCreator        AuditRating[]          @relation("AuditRatingCreator")
  auditRatingModifier       AuditRating[]          @relation("AuditRatingModifier")
  jobTransactionRecipient   JobTransaction[]       @relation("JobTransactionRecipient")
  escalation1_user          User[]                 @relation("escalation1User")
  escalation2_user          User[]                 @relation("escalation2User")
  escalation3_user          User[]                 @relation("escalation3User")
  escalation4_user          User[]                 @relation("escalation4User")
  complianceSecretariat     JobTransaction[]       @relation("ComplianceSecretariat")
  complianceOfficer         JobTransaction[]       @relation("ComplianceOfficer")
  supervisor                JobTransaction[]       @relation("Supervisor")
  jobTransactionVerifier    JobTransaction[]       @relation("JobTransactionVerifier")
  jobTransactionApprover    JobTransaction[]       @relation("JobTransactionApprover")
  holidayCreator            Holiday[]              @relation("HolidayCreator")
  holidayModifier           Holiday[]              @relation("HolidayModifier")
  accessLevelCreator        Role[]                 @relation("AccessLevelCreator")
  accessLevelModifier       Role[]                 @relation("AccessLevelModifier")
  userAccessCreator         UserRole[]             @relation("UserAccessCreator")
  userAccessModifier        UserRole[]             @relation("UserAccessModifier")
  userGroupCreator          UserGroup[]            @relation("UserGroupCreator")
  userGroupModifier         UserGroup[]            @relation("UserGroupModifier")
  userRoles                 UserRole[]
  userGroups                UserGroup[]
  userProjectCreator        UserProject[]          @relation("UserProjectCreator")
  userProjectModifier       UserProject[]          @relation("UserProjectModifier")
  userProjects              UserProject[]
  auditTrails               AuditTrail[]           @relation("AuditTrailCreator")
  jobEscalation1User        JobTransaction[]       @relation("jobEscalation1User")
  jobEscalation2User        JobTransaction[]       @relation("jobEscalation2User")
  jobEscalation3User        JobTransaction[]       @relation("jobEscalation3User")
  jobEscalation4User        JobTransaction[]       @relation("jobEscalation4User")
  holdingHistoryCreator     HoldingHistory[]       @relation("HoldingCreator")
  holdingHistoryEnder       HoldingHistory[]       @relation("HoldingEnder")
  updateTrails              UpdateTrail[]          @relation("UpdateTrailCreator")
  reviewTrails              ReviewTrail[]          @relation("ReviewTrailCreator")
  emailTemplatesCreator     EmailTemplate[]        @relation("EmailTemplateCreator")
  emailTemplatesModifier    EmailTemplate[]        @relation("EmailTemplateModifier")
}

model AuditReport {
  id                Int              @id @default(autoincrement())
  name              String           @unique @db.NVarChar(100)
  companyId         Int
  auditEngagementId Int
  projectId         Int
  effectiveYear     Int?
  effectiveMonth    Int?
  isClosed          Boolean          @default(false) @db.Bit
  isActive          Boolean          @default(true) @db.Bit
  createdBy         Int
  createdOn         DateTime         @default(now()) @db.DateTime
  modifiedBy        Int?
  modifiedOn        DateTime         @updatedAt @db.DateTime
  company           Company          @relation(fields: [companyId], references: [id], onUpdate: NoAction)
  auditEngagement   AuditEngagement  @relation(fields: [auditEngagementId], references: [id], onUpdate: NoAction)
  project           Project          @relation(fields: [projectId], references: [id], onUpdate: NoAction)
  creator           User             @relation("AuditReportCreator", fields: [createdBy], references: [id], onUpdate: NoAction, onDelete: NoAction)
  modifier          User?            @relation("AuditReportModifier", fields: [modifiedBy], references: [id], onUpdate: NoAction, onDelete: NoAction)
  jobTransactions   JobTransaction[]
}

model AuditRating {
  id              Int              @id @default(autoincrement())
  name            String           @db.NVarChar(50)
  companyId       Int
  isActive        Boolean          @default(true) @db.Bit
  createdBy       Int
  createdOn       DateTime         @default(now()) @db.DateTime
  modifiedBy      Int?
  modifiedOn      DateTime         @updatedAt @db.DateTime
  company         Company          @relation(fields: [companyId], references: [id], onUpdate: NoAction)
  creator         User             @relation("AuditRatingCreator", fields: [createdBy], references: [id], onUpdate: NoAction, onDelete: NoAction)
  modifier        User?            @relation("AuditRatingModifier", fields: [modifiedBy], references: [id], onUpdate: NoAction, onDelete: NoAction)
  jobTransactions JobTransaction[]

  @@unique([name, companyId])
}

model Holiday {
  id         Int      @id @default(autoincrement())
  name       String   @db.NVarChar(255)
  type       String   @db.NVarChar(25)
  date       DateTime @unique @db.DateTime
  isActive   Boolean  @default(true) @db.Bit
  createdBy  Int
  createdOn  DateTime @default(now()) @db.DateTime
  modifiedBy Int?
  modifiedOn DateTime @updatedAt @db.DateTime
  creator    User     @relation("HolidayCreator", fields: [createdBy], references: [id], onUpdate: NoAction, onDelete: NoAction)
  modifier   User?    @relation("HolidayModifier", fields: [modifiedBy], references: [id], onUpdate: NoAction, onDelete: NoAction)
}

model Role {
  id         Int        @id @default(autoincrement())
  name       String     @unique @db.NVarChar(100)
  isActive   Boolean    @default(true) @db.Bit
  createdBy  Int
  createdOn  DateTime   @default(now()) @db.DateTime
  modifiedBy Int?
  modifiedOn DateTime   @updatedAt @db.DateTime
  creator    User       @relation("AccessLevelCreator", fields: [createdBy], references: [id], onUpdate: NoAction, onDelete: NoAction)
  modifier   User?      @relation("AccessLevelModifier", fields: [modifiedBy], references: [id], onUpdate: NoAction, onDelete: NoAction)
  userRoles  UserRole[]
}

model UserRole {
  userId     Int
  roleId     Int
  isActive   Boolean  @default(true) @db.Bit
  createdBy  Int
  createdOn  DateTime @default(now()) @db.DateTime
  modifiedBy Int?
  modifiedOn DateTime @updatedAt @db.DateTime
  user       User     @relation(fields: [userId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  role       Role     @relation(fields: [roleId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  creator    User     @relation("UserAccessCreator", fields: [createdBy], references: [id], onUpdate: NoAction, onDelete: NoAction)
  modifier   User?    @relation("UserAccessModifier", fields: [modifiedBy], references: [id], onUpdate: NoAction, onDelete: NoAction)

  @@id([userId, roleId])
}

model UserGroup {
  userId     Int
  groupId    Int
  isActive   Boolean  @default(true) @db.Bit
  createdBy  Int
  createdOn  DateTime @default(now()) @db.DateTime
  modifiedBy Int?
  modifiedOn DateTime @updatedAt @db.DateTime
  user       User     @relation(fields: [userId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  group      Group    @relation(fields: [groupId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  creator    User     @relation("UserGroupCreator", fields: [createdBy], references: [id], onUpdate: NoAction, onDelete: NoAction)
  modifier   User?    @relation("UserGroupModifier", fields: [modifiedBy], references: [id], onUpdate: NoAction, onDelete: NoAction)

  @@id([userId, groupId])
}

model UserProject {
  userId     Int
  projectId  Int
  isActive   Boolean  @default(true) @db.Bit
  createdBy  Int
  createdOn  DateTime @default(now()) @db.DateTime
  modifiedBy Int?
  modifiedOn DateTime @updatedAt @db.DateTime
  user       User     @relation(fields: [userId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  project    Project  @relation(fields: [projectId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  creator    User     @relation("UserProjectCreator", fields: [createdBy], references: [id], onUpdate: NoAction, onDelete: NoAction)
  modifier   User?    @relation("UserProjectModifier", fields: [modifiedBy], references: [id], onUpdate: NoAction, onDelete: NoAction)

  @@id([userId, projectId])
}

model AuditTrail {
  id               Int            @id @default(autoincrement())
  jobTransactionId Int
  jobStatus        String
  actionTaken      String
  tag              String?
  comment          String?        @db.NVarChar(Max)
  createdBy        Int
  createdOn        DateTime       @default(now()) @db.DateTime
  jobTransaction   JobTransaction @relation(fields: [jobTransactionId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  creator          User           @relation("AuditTrailCreator", fields: [createdBy], references: [id], onUpdate: NoAction, onDelete: NoAction)
}

model HoldingHistory {
  id               Int            @id @default(autoincrement())
  jobTransactionId Int
  holdFrom         DateTime       @db.DateTime
  holdUntil        DateTime       @db.DateTime
  isActive         Boolean        @default(true) @db.Bit
  endedOn          DateTime?      @db.DateTime
  endedBy          Int?
  createdBy        Int
  createOn         DateTime       @default(now()) @db.DateTime
  jobTransaction   JobTransaction @relation(fields: [jobTransactionId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  creator          User           @relation("HoldingCreator", fields: [createdBy], references: [id], onUpdate: NoAction, onDelete: NoAction)
  ender            User?          @relation("HoldingEnder", fields: [endedBy], references: [id], onUpdate: NoAction, onDelete: NoAction)
}

model UpdateTrail {
  id               Int            @id @default(autoincrement())
  jobTransactionId Int
  message          String         @db.NVarChar(Max)
  createdBy        Int
  createOn         DateTime       @default(now()) @db.DateTime
  jobTransaction   JobTransaction @relation(fields: [jobTransactionId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  creator          User           @relation("UpdateTrailCreator", fields: [createdBy], references: [id], onUpdate: NoAction, onDelete: NoAction)
}

model ReviewTrail {
  id               Int            @id @default(autoincrement())
  jobTransactionId Int
  message          String         @db.NVarChar(Max)
  createdBy        Int
  createOn         DateTime       @default(now()) @db.DateTime
  jobTransaction   JobTransaction @relation(fields: [jobTransactionId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  creator          User           @relation("ReviewTrailCreator", fields: [createdBy], references: [id], onUpdate: NoAction, onDelete: NoAction)
}

model EmailLog {
  id               Int      @id @default(autoincrement())
  recipientAddress String   @db.NVarChar(Max)
  subject          String   @db.NVarChar(Max)
  content          String   @db.NVarChar(Max)
  carbonCopy       String   @db.NVarChar(Max)
  sentOn           DateTime @default(now()) @db.DateTime
  isValid          Boolean  @db.Bit
}

model EmailTemplate {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  subject     String   @db.NVarChar(500)
  content     String   @db.NVarChar(Max)
  description String   @db.NVarChar(500)
  isActive    Boolean  @default(true) @db.Bit
  createdBy   Int
  createdOn   DateTime @default(now()) @db.DateTime
  modifiedBy  Int?
  modifiedOn  DateTime @updatedAt
  creator     User     @relation("EmailTemplateCreator", fields: [createdBy], references: [id], onUpdate: NoAction, onDelete: NoAction)
  mofifier    User?    @relation("EmailTemplateModifier", fields: [modifiedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
}
