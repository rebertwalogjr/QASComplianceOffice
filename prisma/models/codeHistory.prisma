model CodeHistory {
  id        Int      @id @default(autoincrement())
  userId    Int
  codeHash  String   @db.NVarChar(128)
  expiresOn DateTime @db.DateTime
  isActive  Boolean  @default(true) @db.Bit
  createdOn DateTime @default(now()) @db.DateTime
  user      User     @relation(fields: [userId], references: [id])
}
