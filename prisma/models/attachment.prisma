model Attachment {
  id               Int            @id @default(autoincrement())
  jobTransactionId Int
  fileName         String         @db.NVarChar(255)
  fileType         String         @db.NVarChar(255)
  fileSize         Int
  fromRecipient    Boolean
  isActive         Boolean        @default(true) @db.Bit
  createdBy        Int
  createdOn        DateTime       @default(now()) @db.DateTime
  modifiedBy       Int?
  modifiedOn       DateTime       @updatedAt @db.DateTime
  creator          User           @relation("AttachmentCreator", fields: [createdBy], references: [id], onUpdate: NoAction, onDelete: NoAction)
  modifier         User?          @relation("AttachmentModifier", fields: [modifiedBy], references: [id], onUpdate: NoAction, onDelete: NoAction)
  jobTransaction   JobTransaction @relation(fields: [jobTransactionId], references: [id])
}